<Project>

  <!--
    Central package version management. Versions are stated HERE ONLY; a .csproj carries
    <PackageReference Include="..." /> without Version. Versions are pinned exactly: no ranges,
    no floating tags. A version bump is a separate change, made after reading the release notes.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="Data access">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup Label="Identity and security">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <PackageVersion Include="BCrypt.Net-Next" Version="4.2.1" />
  </ItemGroup>

  <ItemGroup Label="HTTP / OpenAPI">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.17.14" />
  </ItemGroup>

  <ItemGroup Label="Analysers (versions here, wired up in Directory.Build.props)">
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.294" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <!-- xunit v3 runs through Microsoft.Testing.Platform: Microsoft.NET.Test.Sdk is not needed -->
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageVersion Include="TngTech.ArchUnitNET.xUnitV3" Version="0.13.4" />
  </ItemGroup>

</Project>
